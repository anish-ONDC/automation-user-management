PORT=8080
ENV=development

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=

# Login via ONDC (SSO Onboarding Guide v1.2). Set LOGIN_PROVIDER=ondc to use it;
# GitHub stays the default. ONDC registers the callback per environment:
# <this service's address>/auth/ondc/callback. Keep the secret out of git and logs.
LOGIN_PROVIDER=github
ONDC_PORTAL_BASE_URL=
ONDC_API_BASE_URL=
ONDC_SSO_CLIENT_ID=
ONDC_SSO_CLIENT_SECRET=

CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017
DB_NAME=developer_guide_db

# JWT
JWT_SECRET=

# MCP API keys
# MCP_KEY_TTL_DAYS must match section 3 of the MCP consent document. If you
# change it, change the document and bump MCP_CONSENT_VERSION too.
MCP_KEY_TTL_DAYS=90
MCP_CONSENT_VERSION=2026-10-v1
# Optional. When set, /mcp/verify additionally requires a matching
# X-Service-Token header. Generate with: openssl rand -base64 32
MCP_SERVICE_TOKEN=

# Redis shared with the MCP server. On key regenerate/revoke we delete the MCP's
# cached check for the old key here, so it stops working immediately. Unset
# REDIS_HOST disables that (the old key then works until the MCP's cache expires).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# Must equal the MCP server's REDIS_KEY_PREFIX.
MCP_REDIS_KEY_PREFIX=ondc-mcp
